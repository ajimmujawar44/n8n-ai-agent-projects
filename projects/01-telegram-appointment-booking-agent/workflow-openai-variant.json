      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{\n`🏥 Hospital Appointment Booking Assistant\n\nHello ${$node[\"Telegram Trigger\"].json.message.from.first_name}! 👋\n\nI can help you schedule your hospital appointment.\n\nPlease provide the following details:\n\n👤 Patient Name:\n📱 Phone Number:\n📅 Appointment Date (DD-MM-YYYY):\n⏰ Appointment Time (include AM/PM):\n\nOptional:\n👨‍⚕️ Preferred Doctor Type:\n• General Physician\nOR\n• Specialist (e.g., Cardiologist, Dermatologist, Orthopedic, Neurologist)\n\nExample:\n\n👤 Patient Name: Kumar\n📱 Phone Number: +91 9876543210\n📅 Appointment Date: 22-07-2026\n⏰ Appointment Time: 9:00 AM\n👨‍⚕️ Doctor Type: General Physician\n\n📩 Reply with the details in the above format.\n\nOnce you provide these details, I will proceed with your appointment request.`\n}}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML"
        }
      },
