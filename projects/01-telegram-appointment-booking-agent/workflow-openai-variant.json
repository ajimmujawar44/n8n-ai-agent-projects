      "parameters": {
        "promptType": "define",
        "text": "=GOAL:\nClassify the user's message.\n\nPossible intents:\n- greeting\n- appointment_booking\n- other\n\nRules:\n- greeting: User says hi, hello, hey, good morning, good evening, start, etc.\n- appointment_booking: User wants to book an appointment or mentions a date/time for a hospital visit.\n- other: Any message unrelated to hospital appointment booking.\n\nReturn ONLY valid JSON:\n\n{\n  \"intent\": \"\"\n}\n\nUser Message:\n{{$json.message.text}}",
        "hasOutputParser": true,
        "options": {}
