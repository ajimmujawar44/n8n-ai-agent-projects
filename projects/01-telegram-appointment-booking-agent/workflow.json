    {
      "parameters": {
        "promptType": "define",
        "text": "=GOAL:\nCollect the information required to book a hospital appointment.\n\nRequired Fields:\n- patient_name\n- phone_number\n- appointment_date\n- appointment_time (must include AM or PM)\n\nOptional Field:\n- \"doctor_specialization\": \"Would you like to consult a specialist doctor or a General Physician? If a specialist, please mention the specialization.\"\nInstructions:\n\n- Extract the required fields from the conversation.\n- Use conversation memory to retain previously collected information.\n- Do not ask again for fields that are already available.\n- Never assume or invent any missing information.\n- If the user does not explicitly provide a required field, leave it empty and include it in \"missing_fields\".\n- doctor_specialization is optional and must never be included in \"missing_fields\".\n- If the user specifies a specialist, store the specialization exactly as provided.\n- If the user explicitly requests a General Physician, set:\n  \"doctor_specialization\": \"General Physician\"\n- If the user does not mention a doctor preference, set:\n  \"doctor_specialization\": \"General Physician\"\n\nReturn ONLY valid JSON.\n\nIf required information is incomplete:\n\n{\n  \"status\": \"incomplete\",\n  \"patient_name\": \"\",\n  \"phone_number\": \"\",\n  \"appointment_date\": \"\",\n  \"appointment_time\": \"\",\n  \"doctor_specialization\": \"\",\n  \"missing_fields\": []\n}\n\nIf all required information is available:\n\n{\n  \"status\": \"complete\",\n  \"patient_name\": \"\",\n  \"phone_number\": \"\",\n  \"appointment_date\": \"\",\n  \"appointment_time\": \"\",\n  \"doctor_specialization\": \"\"\n}\n\nUser Message:\n{{ $('Telegram Trigger').item.json.message.text }}",
        "hasOutputParser": true,
        "options": {}
      },
      "id": "f48c36f3-c446-4c1b-ba81-952b1bac1c82",
